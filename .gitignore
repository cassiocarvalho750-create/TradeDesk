/painel_us*.json
/painel_b3*.json
/painel_etf*.json
/painel_forex*.json

# relatorios gerados na raiz pelo scanner local
/scanner_us*.html
/scanner_b3*.html
/scanner_us*_tradedesk_*.json
/scanner_b3*_tradedesk_*.json
/ultimo_scan.txt

# cache do Python
__pycache__/
*.pyc
